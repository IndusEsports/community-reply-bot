# --- Core ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
BOT_MODE=review                 # review | auto
DASHBOARD_PASSWORD=change-me
DB_PATH=./bot.db                # only used if DATABASE_URL is blank
DATABASE_URL=                   # Supabase Postgres connection string (session pooler recommended — see README)
POLL_INTERVAL_SECONDS=90
DAILY_REPLY_CAP=150

# --- Public URL (needed for OAuth redirect URIs) ---
PUBLIC_BASE_URL=                # e.g. https://your-app.up.railway.app — no trailing slash

# --- One OAuth app per platform, shared across every connected account.
#     Per-account tokens are NOT set here anymore — connect them from the
#     dashboard's /connections page; they're stored in Supabase. ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
X_API_KEY=
X_API_SECRET=
