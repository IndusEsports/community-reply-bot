# --- Core ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
BOT_MODE=review                 # review | auto
DASHBOARD_PASSWORD=change-me
DB_PATH=./bot.db                # only used if DATABASE_URL is blank; Railway: /data/bot.db once a volume's mounted
DATABASE_URL=                   # optional: Supabase Postgres connection string (direct, port 5432) — leave blank to use SQLite above
POLL_INTERVAL_SECONDS=90
DAILY_REPLY_CAP=150

# --- YouTube (Indus / Showdown) ---
INDUS_YT_ENABLED=false
INDUS_YT_CHANNEL_ID=
INDUS_YT_CLIENT_ID=
INDUS_YT_CLIENT_SECRET=
INDUS_YT_REFRESH_TOKEN=

# --- Instagram (Indus / Showdown) ---
INDUS_IG_ENABLED=false
INDUS_IG_USER_ID=
INDUS_IG_ACCESS_TOKEN=

# --- X / Twitter (Indus / Showdown) ---
INDUS_X_ENABLED=false
INDUS_X_HANDLE=
INDUS_X_API_KEY=
INDUS_X_API_SECRET=
INDUS_X_ACCESS_TOKEN=
INDUS_X_ACCESS_SECRET=

# --- Copy this whole block again with PRIMERUSH_ prefixes to add a second game ---
